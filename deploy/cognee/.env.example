# OP-1019 / AUDIT-29b-1 — Cognee container runtime configuration.
#
# Copy to deploy/cognee/.env and set deployment-specific secrets before:
#   docker compose -f deploy/cognee/docker-compose.yml --env-file deploy/cognee/.env up -d

COGNEE_HOST_PORT=8002
COGNEE_REQUIRE_AUTHENTICATION=true
COGNEE_AUTH_EMAIL=operator@example.com
COGNEE_AUTH_PASSWORD=replace-with-a-strong-password

# Cognee performs LLM and embedding checks on first real work. Provide the
# provider credentials used by the target environment before cognify/search.
LLM_PROVIDER=openai
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_API_KEY=

# Default single-container storage. Later AUDIT-29b tickets can switch these
# to Neo4j/Postgres/Chroma once those services are live.
DB_PROVIDER=sqlite
GRAPH_DATABASE_PROVIDER=kuzu
VECTOR_DB_PROVIDER=lancedb
