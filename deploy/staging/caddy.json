{
  "apps": {
    "http": {
      "servers": {
        "staging": {
          "listen": [":80", ":443"],
          "routes": [
            {
              "match": [
                {
                  "path": ["/api/*", "/audit/*", "/readyz", "/healthz", "/health"]
                }
              ],
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "health_checks": {
                    "active": {
                      "uri": "/readyz",
                      "interval": "10s",
                      "timeout": "3s"
                    }
                  },
                  "upstreams": [
                    {"dial": "backend-a:8000"},
                    {"dial": "backend-b:8001"}
                  ]
                }
              ]
            }
          ]
        }
      }
    }
  }
}
