# [OP-1700] deploy/dev/.env.example — template for the isolated dev stack.
#
#   cp deploy/dev/.env.example deploy/dev/.env   # then edit the two REQUIRED values below
#
# Safe defaults only — NO real secrets (the real .env is gitignored). Every var
# here is actually consumed by deploy/dev/docker-compose.yml; the dev stack is a
# lean single-backend topology (postgres + backend-a + a profile-gated inert
# dag-executor), so there is intentionally NO frontend / caddy / backend-b and
# therefore no DEV_FRONTEND_PORT / DEV_HTTP_PORT / DEV_HTTPS_PORT /
# DEV_BACKEND_B_PORT (those were stale, unused declarations — removed per OP-1700).
#
# Copying this file as-is and only filling POSTGRES_PASSWORD + OMNISIGHT_IMAGE_TAG
# yields a config that passes infra/dev/verify-env-contract.sh.

# ── Postgres (own dev DB; role is REVOKE'd CONNECT on prod — fails closed) ──
POSTGRES_USER=omnisight_dev
# REQUIRED — set a local-only dev password. Never commit the real value.
POSTGRES_PASSWORD=CHANGE_ME_dev_only
POSTGRES_DB=omnisight_dev
# Host-published Postgres port (container side is always 5432).
DEV_POSTGRES_PORT=58432

# ── backend-a (the dev API) ────────────────────────────────────────────────
# Host-published API port. Bound to 127.0.0.1 in compose (OP-1700): dev runs
# DEBUG=1 + AUTH_MODE=open, so it must never be reachable off-host.
DEV_BACKEND_A_PORT=8020

# Image source. OMNISIGHT_IMAGE_TAG is REQUIRED (no default in compose) so dev
# never silently runs a stale/implicit tag.
OMNISIGHT_REGISTRY=sora.services:49160/omnisight/omnisight-productizer
OMNISIGHT_IMAGE_TAG=

# Dev posture — open auth + debug. Keep these as-is for a local dev stack; they
# are the reason backend-a binds to loopback only.
OMNISIGHT_DEBUG=1
OMNISIGHT_AUTH_MODE=open

# OMNISIGHT_ENV is hardcoded to `dev` in compose; declared here so a by-hand run
# of infra/dev/verify-env-contract.sh against this .env also passes.
OMNISIGHT_ENV=dev

# ── dag-executor (ships INERT; profile-gated AND armed-flag default OFF) ─────
# Leave both empty/0 unless you are intentionally arming the executor in dev.
# Arm only via: --profile dag-executor up -d dag-executor  with these set.
OMNISIGHT_DAG_EXECUTOR_ENABLED=0
OMNISIGHT_DAG_EXECUTOR_PLAN_ALLOWLIST=
