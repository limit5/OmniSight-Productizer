; [OP-883] Persistent 30-second SLO monitor for production deploys.
;
; The process runs continuously and evaluates config/slo_thresholds.yaml
; every 30 s. It defaults to full rollback while progressive canary is HOLD'd
; and no canary_state.json exists.

[Unit]
Description=OmniSight deploy SLO monitor (OP-883)
After=network-online.target omnisight-compose-prod.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/sora-bridge
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/sora-bridge/.env
# OP-1636/F4: ~/sora-bridge has no venv (OP-1634 repointed here but assumed one);
# use the system python3 like pipeline-coordinator.service does. WorkingDirectory
# = ~/sora-bridge so `backend.orchestrator.slo_monitor` resolves.
ExecStart=/usr/bin/python3 -m backend.orchestrator.slo_monitor
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=default.target
