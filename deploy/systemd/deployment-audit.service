; [OP-1016] Daily deployment-audit baseline.
;
; Runs scripts/deployment-audit.sh at the canonical repo path and appends a
; machine-readable JSONL row to the existing release-conductor audit surface.
; Any fatal red row makes the script exit non-zero, which triggers
; deployment-audit-alert.service through OnFailure.
;
; CANONICAL COPY (OP-1738): the ONLY copy that should run is the develop-tip
; sora-bridge checkout below (WorkingDirectory + ExecStart). The script now
; self-identifies its repo + git ref in its banner, so an accidental run from a
; stale `main` checkout is visible at a glance. Remove or symlink any stale main
; checkout copy to this one — do not keep two divergent copies.
;
; OMNISIGHT_DEPLOYED_TAG (OP-1738): no longer required here — the script defaults
; it from the committed promotion ledger (audit/image_promotion_audit.jsonl) so
; the alembic-head `auto` row asserts prod is at the promoted release. Set it (or
; OMNISIGHT_AUDIT_DEPLOY_REF) in release-audit.env only to override that default.
;
; Install (user-level):
;   mkdir -p ~/.config/systemd/user
;   cp deploy/systemd/deployment-audit.{service,timer} ~/.config/systemd/user/
;   cp deploy/systemd/deployment-audit-alert.service ~/.config/systemd/user/
;   systemctl --user daemon-reload
;   systemctl --user enable --now deployment-audit.timer

[Unit]
Description=OmniSight deployment audit baseline (OP-1016)
After=network-online.target
Wants=network-online.target
OnFailure=deployment-audit-alert.service

[Service]
Type=oneshot
WorkingDirectory=/home/user/sora-bridge
EnvironmentFile=-/home/user/sora-bridge/.env
EnvironmentFile=-/home/user/.config/omnisight/audit-db.env
EnvironmentFile=-/home/user/.config/omnisight/release-audit.env
Environment=DEPLOYMENT_AUDIT_JSONL_LOG=/home/user/work/sora/logs/release-conductor/audit.jsonl
ExecStart=/usr/bin/bash /home/user/sora-bridge/scripts/deployment-audit.sh
StandardOutput=append:/home/user/work/sora/logs/deployment-audit/run.log
StandardError=append:/home/user/work/sora/logs/deployment-audit/run.log
TimeoutStartSec=300

[Install]
WantedBy=default.target
