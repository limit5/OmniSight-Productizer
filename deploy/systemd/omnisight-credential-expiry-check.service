; systemd oneshot unit for the daily credential expiry check (OP-727).
;
; Pairs with omnisight-credential-expiry-check.timer. The timer fires
; once a day; this unit runs the check, prints the report, and exits.
; Stdout/stderr land in the journal — `journalctl -u
; omnisight-credential-expiry-check.service` shows the latest report.
;
; Exit codes (see scripts/credential_expiry_check.py):
;   0 = ok          1 = warning band (≤ 30d)
;   2 = urgent band (≤ 7d)   3 = critical / expired (≤ 1d)
;
; A non-zero exit is what the alert dispatcher (T1) hooks into via
; `OnFailure=` in a sibling alerting unit. We deliberately do NOT
; `Restart=on-failure` here — the failure carries the signal.
;
; Install:
;   sudo cp deploy/systemd/omnisight-credential-expiry-check.{service,timer} \
;       /etc/systemd/system/
;   # Edit USER_HOME / USERNAME placeholders to match your deployment.
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now omnisight-credential-expiry-check.timer

[Unit]
Description=OmniSight credential expiry check (daily, OP-727)
Documentation=file:///home/USER_HOME/work/sora/OmniSight-Productizer/docs/operations/credential_rotation_runbook.md
After=network-online.target

[Service]
Type=oneshot
User=USERNAME
WorkingDirectory=/home/USER_HOME/work/sora/OmniSight-Productizer
ExecStart=/usr/bin/python3 scripts/credential_expiry_check.py \
    --inventory configs/credentials.yaml \
    --format text

; Hardening. The check only reads a YAML file under the repo —
; nothing else needs to be writable, network-reachable, or privileged.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/USER_HOME/work/sora/OmniSight-Productizer
PrivateTmp=yes
PrivateNetwork=yes
