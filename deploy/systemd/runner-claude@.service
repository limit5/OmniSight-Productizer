; systemd template unit — OmniSight claude runner instance N (OP-783).
;
; Twin of runner-codex@.service, scoped to the Anthropic subscription
; class. See that file's header for install + idempotency notes.
;
; Install:
;   cp deploy/systemd/runner-claude@.service ~/.config/systemd/user/
;   systemctl --user daemon-reload
;   systemctl --user enable --now runner-claude@default     # legacy
;   systemctl --user enable --now runner-claude@2           # claude-bot-2
;   systemctl --user enable --now runner-claude@3           # claude-bot-3

[Unit]
Description=OmniSight Claude Runner Instance %i (OP-783)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/work/sora/OmniSight-Productizer
Environment=PYTHONUNBUFFERED=1
Environment=OMNISIGHT_RUNNER_CLASS=subscription-claude
Environment=OMNISIGHT_RUNNER_INSTANCE_ID=%i
Environment=OMNISIGHT_MEMORY_TOOL_ROOT=/var/omnisight/memory
Environment=OMNISIGHT_MEMORY_TOOL_CAP_MB=100
Environment=OMNISIGHT_IDEMPOTENCY_DB_PATH=%h/.config/omnisight/idem-keys-claude-bot-%i.db
; OP-845: bubblewrap sandbox wrapper for CLI invocations.
;
; Production hosts: install `bubblewrap` (apt install bubblewrap) and set
;   Environment=OMNISIGHT_RUNNER_SANDBOX_ENFORCE=1
; so a missing binary aborts the pickup instead of silently degrading to
; a raw (un-jailed) invocation. Verify after deploy:
;   journalctl --user -u runner-claude@%i.service | grep 'sandbox=wrapped'
;
; Dev hosts: leave the env unset; the runner logs `sandbox=degraded` and
; runs raw so a workstation without bubblewrap installed isn't blocked.
;
; Network deny by default. For tickets that genuinely need network
; (web scraping, dep-fetch outside cache), set per-pickup:
;   Environment=OMNISIGHT_RUNNER_SANDBOX_NETWORK_ALLOW=<audit-reason>
;Environment=OMNISIGHT_RUNNER_SANDBOX_ENFORCE=1
ExecStart=%h/work/sora/OmniSight-Productizer/deploy/runner-wrappers/runner-claude.sh %i
Restart=on-failure
RestartSec=90
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=append:%h/work/sora/logs/runner/claude-bot-%i.log
StandardError=append:%h/work/sora/logs/runner/claude-bot-%i.log

[Install]
WantedBy=default.target
