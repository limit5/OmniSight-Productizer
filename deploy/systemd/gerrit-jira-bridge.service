; systemd unit for the OmniSight Gerrit/JIRA bridge (OP-689 + OP-715 + OP-717).
;
; Install (user-level — no sudo):
;   mkdir -p ~/.config/systemd/user
;   cp deploy/systemd/gerrit-jira-bridge.service ~/.config/systemd/user/
;   # Edit the Environment= lines below to match your bot identity + paths.
;   systemctl --user daemon-reload
;   systemctl --user enable --now gerrit-jira-bridge
;   loginctl enable-linger $USER     # survive logout

[Unit]
Description=OmniSight Gerrit/JIRA bridge (OP-689 + OP-715 + OP-717)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/user/sora-bridge
Environment=PYTHONPATH=/home/user/sora-bridge
; OP-717 deploy fix #1: keep stdout line-buffered so logger.info() lands
; in the systemd journal in real time (without this Python buffers and
; logs only flush at process exit, making live debugging impossible).
Environment=PYTHONUNBUFFERED=1
; OP-717 deploy fix #2: gerrit_enabled gates the legacy shim's
; `default-gerrit` virtual git_accounts row construction. Without this
; True, gerrit_client.query_change returns 'no account configured'
; and every proactive-merger thread short-circuits with skip_reason
; =gerrit_query_no_result before reaching the enrichment step.
Environment=OMNISIGHT_GERRIT_ENABLED=true
; SSH host MUST include the bot username (claude-bot@host) — the
; `_ssh_args_for` helper does not auto-prepend username to the SSH
; argv, so plain hostname falls through to $USER@host (= the system
; user, who has no Gerrit ACL).
Environment=OMNISIGHT_GERRIT_SSH_HOST=claude-bot@sora.services
Environment=OMNISIGHT_GERRIT_URL=https://sora.services:29420
Environment=OMNISIGHT_GERRIT_PROJECT=omnisight/OmniSight-Productizer
Environment=OMNISIGHT_GIT_SSH_KEY_PATH=/home/user/.config/omnisight/gerrit-claude-bot-ed25519
; OP-722: operator-notifier bridge. Channels with missing config are
; silently omitted (the JIRA channel is always wired since the bridge
; already has dispatch creds). Edit each value to match operator's
; ops budget — see docs/sop/notifier-config.md for the recipe.
;
; Default JIRA ticket the notifier comments on when notify() callers
; do not specify their own ticket (e.g. daemon-level alerts).
Environment=OMNISIGHT_NOTIFIER_JIRA_TICKET=OP-721
Environment=OMNISIGHT_NOTIFIER_AGENT_CLASS=subscription-claude
; Email (DEGRADED+). Leave SMTP_HOST empty to disable. Submission port
; 587 is implied if you don't include `:port`.
;Environment=OMNISIGHT_NOTIFIER_SMTP_HOST=smtp.mailgun.org
;Environment=OMNISIGHT_NOTIFIER_SMTP_USER=postmaster@mg.example.com
;Environment=OMNISIGHT_NOTIFIER_SMTP_PASSWORD=__rotate_me__
;Environment=OMNISIGHT_NOTIFIER_SMTP_FROM=ops@example.com
;Environment=OMNISIGHT_NOTIFIER_EMAIL_RECIPIENTS=oncall@example.com
; Slack (CRITICAL/P0). Webhook URL carries auth.
;Environment=OMNISIGHT_NOTIFIER_SLACK_WEBHOOK=https://hooks.slack.com/services/T.../B.../...
; LINE Notify (CRITICAL/P0).
;Environment=OMNISIGHT_NOTIFIER_LINE_TOKEN=__rotate_me__
; Ack URL prefix — operator-notifier appends /<notification_id>.
;Environment=OMNISIGHT_NOTIFIER_ACK_BASE_URL=https://ops.example.com/notifier/ack
; Coalescing + re-page tunables (see notifier-config.md for trade-offs).
;Environment=OMNISIGHT_NOTIFIER_DEDUP_WINDOW_SECONDS=300
;Environment=OMNISIGHT_NOTIFIER_CRITICAL_REPAGE_SECONDS=600
;Environment=OMNISIGHT_NOTIFIER_P0_REPAGE_SECONDS=300
; OP-831: cursor file path. The bridge originally hard-coded
; /var/lib/omnisight-bridge/event-cursor.json which is root-owned and
; not writable by user-level systemd; the resulting PermissionError
; crash-looped the daemon for ~16 minutes on 2026-05-11 before it was
; force-paused. Default for user-level installs lands under XDG state
; (~/.local/state/omnisight-bridge/) so mkdir succeeds without sudo.
; System-level installs that already have /var/lib/omnisight-bridge
; provisioned can leave this commented out — the code falls back to
; the legacy path automatically.
Environment=OMNISIGHT_BRIDGE_CURSOR_FILE=/home/user/.local/state/omnisight-bridge/event-cursor.json
; OP-845: the bridge itself does not invoke a CLI inside a sandbox, but
; the runner instances it monitors do. Operator install checklist:
;   apt install bubblewrap     # bwrap on PATH (verify: which bwrap)
;   echo OMNISIGHT_RUNNER_SANDBOX_ENFORCE=1 >> runner-claude@.service
;   journalctl --user -u runner-claude@default | grep sandbox=wrapped
; See docs/operations/runner-sandbox.md for the full DoD.
ExecStart=/usr/bin/python3 /home/user/sora-bridge/scripts/run_gerrit_jira_bridge.py --agent-class subscription-claude
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/home/user/work/sora/logs/bridge/systemd.log
StandardError=append:/home/user/work/sora/logs/bridge/systemd.log

[Install]
WantedBy=default.target
