; [OP-769] Consumer for staging_passed release events.
;
; Install (user-level - no sudo):
;   mkdir -p ~/.config/systemd/user
;   cp deploy/systemd/auto-tag-release.service ~/.config/systemd/user/
;   systemctl --user daemon-reload
;   systemctl --user enable --now auto-tag-release.service
;   loginctl enable-linger $USER

[Unit]
Description=OmniSight release tag and branch updater (OP-769)
After=network-online.target auto-promote-main.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/user/sora-bridge
Environment=PYTHONPATH=/home/user/sora-bridge
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m backend.agents.auto_tag_release \
  --repo /home/user/sora-bridge \
  --event-log /home/user/work/sora/logs/release-milestone/staging.log \
  --cursor /home/user/work/sora/logs/release-milestone/auto-tag-release.cursor \
  --main-branch main \
  --tag-remotes gerrit,gitlab \
  --branch-remotes gerrit,gitlab
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
StandardOutput=append:/home/user/work/sora/logs/release-milestone/auto-tag-release.log
StandardError=append:/home/user/work/sora/logs/release-milestone/auto-tag-release.log

[Install]
WantedBy=default.target
