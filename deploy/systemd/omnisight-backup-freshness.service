[Unit]
Description=OmniSight off-site backup freshness probe — newest COMPLETE cohort (OP-2731)
Documentation=https://soraapp.atlassian.net/browse/OP-2731
OnFailure=omnisight-alert@%n.service

[Service]
Type=oneshot
# Stage is deliberately pinned here rather than defaulted in the script: an
# absent stage FAILS. Tighten to s2_encrypted with F1 and s3_attested with P1,
# in the same commit as the capability each depends on.
Environment=OMNISIGHT_BACKUP_FRESHNESS_STAGE=s1_payload_digest
Environment=OMNISIGHT_BACKUP_MAX_AGE_DAYS=2
ExecStart=/home/user/.local/bin/omnisight-backup-freshness.py
StandardOutput=append:/home/user/work/sora/logs/backup/freshness.log
StandardError=append:/home/user/work/sora/logs/backup/freshness.log
