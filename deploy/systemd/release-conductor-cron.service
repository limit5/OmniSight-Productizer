; [OP-939] systemd unit for the release conductor daily cron skeleton.
;
; Install (user-level -- no sudo):
;   mkdir -p ~/.config/systemd/user
;   cp deploy/systemd/release-conductor-cron.{service,timer} ~/.config/systemd/user/
;   systemctl --user daemon-reload
;   systemctl --user enable --now release-conductor-cron.timer
;   loginctl enable-linger $USER

[Unit]
Description=OmniSight release conductor cron (OP-939)
After=network-online.target gerrit-jira-bridge.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/user/sora-bridge
Environment=PYTHONPATH=/home/user/sora-bridge
Environment=PYTHONUNBUFFERED=1
Environment=OMNISIGHT_JIRA_AGENT_CLASS=subscription-codex
Environment=OMNISIGHT_GERRIT_SSH_HOST=codex-bot@sora.services
Environment=OMNISIGHT_GERRIT_SSH_PORT=29418
Environment=OMNISIGHT_GERRIT_PROJECT=omnisight/OmniSight-Productizer
Environment=OMNISIGHT_GIT_SSH_KEY_PATH=/home/user/.config/omnisight/gerrit-codex-bot-ed25519
ExecStart=/bin/bash /home/user/sora-bridge/scripts/release_conductor_cron.sh
StandardOutput=append:/home/user/work/sora/logs/release-conductor/systemd.log
StandardError=append:/home/user/work/sora/logs/release-conductor/systemd.log
TimeoutStartSec=600

[Install]
WantedBy=default.target
