; [OP-1066] Hourly trigger for the Anthropic-API surface-drift canary.
;
; Cadence: 1 hour. ``Persistent=true`` so a host that was offline
; during a scheduled tick fires immediately on resume rather than
; waiting another full hour. AC: hourly cadence required.
;
; OnBootSec=3min keeps the canary off the boot-time hot path so a
; flaky DNS or network on cold-start does not mask as an API drift
; alert before the runner itself has even come up.

[Unit]
Description=Hourly trigger for anthropic-api-canary.service (OP-1066)

[Timer]
Unit=anthropic-api-canary.service
OnBootSec=3min
OnUnitActiveSec=1h
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
