; Timer for the daily credential expiry check (OP-727).
;
; Fires once per day at 09:00 local time, after the operator's
; morning hand-off window — alerts land in the journal in time
; for triage at the start of the day.
;
; Persistent=true catches missed runs (host down, paused VM): the
; check fires on the next boot rather than silently skipping.

[Unit]
Description=Daily credential expiry check (OP-727)
Documentation=file:///home/USER_HOME/work/sora/OmniSight-Productizer/docs/operations/credential_rotation_runbook.md

[Timer]
OnCalendar=*-*-* 09:00:00
Persistent=true
Unit=omnisight-credential-expiry-check.service
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
