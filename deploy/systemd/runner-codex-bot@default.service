; [OP-1025] systemd user unit -- legacy codex-bot runner.
;
; Install:
;   mkdir -p ~/.config/systemd/user
;   cp deploy/systemd/runner-codex-bot@default.service ~/.config/systemd/user/
;   systemctl --user daemon-reload
;   systemctl --user enable --now runner-codex-bot@default.service
;   loginctl enable-linger "$USER"

[Unit]
Description=OmniSight Codex Runner codex-bot (OP-1025)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/work/sora/OmniSight-Productizer
Environment=PYTHONUNBUFFERED=1
Environment=OMNISIGHT_RUNNER_CLASS=subscription-codex
Environment=OMNISIGHT_RUNNER_INSTANCE_ID=default
Environment=OMNISIGHT_MEMORY_TOOL_ROOT=/var/omnisight/memory
Environment=OMNISIGHT_MEMORY_TOOL_CAP_MB=100
Environment=OMNISIGHT_IDEMPOTENCY_DB_PATH=%h/.config/omnisight/idem-keys-codex-bot-default.db
ExecStart=%h/work/sora/OmniSight-Productizer/deploy/runner-wrappers/runner-codex.sh default
Restart=on-failure
RestartSec=90
KillSignal=SIGTERM
TimeoutStopSec=60
StandardOutput=append:%h/work/sora/logs/runner/codex-bot-default.log
StandardError=append:%h/work/sora/logs/runner/codex-bot-default.log

[Install]
WantedBy=default.target
