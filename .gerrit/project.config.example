# O7 (#270) — OmniSight Gerrit project.config reference.
#
# This is the authoritative Gerrit submit-rule policy for OmniSight:
#
#   *** A change is only submittable when ALL of the following hold ***
#
#     (A) ≥1 Code-Review: +2 from a member of the `non-ai-reviewer` group
#         (i.e. a *human* reviewer).  This is the HARD GATE — no
#         amount of AI approval can substitute for it.
#
#     (B) When the change carries the `Merge-Conflict-Resolved` hashtag
#         (set by the O6 Merger Agent after resolving a conflict block),
#         ≥1 Code-Review: +2 from a member of the `merger-agent-bot`
#         group is also required.  Non-conflict changes skip this rule
#         (see OP-694 — conditional Merger-Plus-2).
#
#     (C) No -1 / -2 votes anywhere (No-Veto rule).
#
# Rule (A) is the CLAUDE.md L1 Safety Rule promotion.  Rule (B) is the
# O6 Merger contract — the merge conflict region must be AI-verified by
# the merger before humans are asked to sign off on it.  All three rules
# are encoded as declarative `[submit-requirement "..."]` blocks below.
#
# Group-based, NOT identity-based: adding a new AI reviewer (lint-bot /
# security-bot / any future bot) only requires adding the account to
# `ai-reviewer-bots` — no change to this rule.
#
# Install on `refs/meta/config` (per docs/ops/gerrit_dual_two_rule.md):
#
#   git fetch origin refs/meta/config:refs/remotes/origin/meta/config
#   git checkout meta/config
#   cp ../.gerrit/project.config.example project.config
#   git add project.config
#   git commit -m "OP-692: dual-+2 submit-requirements (human hard gate + conditional merger)"
#   git push origin HEAD:refs/meta/config
#
# Webhooks live in a separate `webhooks.config` file on the same ref —
# the webhooks plugin reads ONLY that file (per OP-713 lesson L22).
# See `.gerrit/webhooks.config.example` if/when added.
#
# Historical: an earlier attempt used a Prolog `rules.pl` for the
# submit-rule.  Gerrit 3.13 rejects new `rules.pl` uploads, so the policy
# moved entirely to declarative `[submit-requirement "..."]` blocks
# (OP-692 / OP-694 / OP-697).  The previous `.gerrit/rules.pl` was
# deleted as dead code.

[project]
    description = OmniSight productizer backend + frontend.
    state = active
    submitType = REBASE_IF_NECESSARY

[access "refs/heads/*"]
    # All AI reviewer bots (merger-agent-bot, lint-bot, security-bot, …)
    # can cast Code-Review votes but NEVER submit.
    label-Code-Review = -2..+2 group ai-reviewer-bots
    label-Code-Review = -2..+2 group non-ai-reviewer
    submit = group non-ai-reviewer
    # O10 (#273): Least-privilege for AI reviewer bots.  Explicitly
    # DENY every dangerous verb so even if Gerrit default policy
    # changes upstream, the bots stay trapped in Code-Review land.
    # DENY takes precedence over any later ALLOW on the same ref.
    deny submit = group ai-reviewer-bots
    deny abandon = group ai-reviewer-bots
    deny delete = group ai-reviewer-bots
    deny deleteChanges = group ai-reviewer-bots
    deny owner = group ai-reviewer-bots
    deny rebase = group ai-reviewer-bots
    deny editTopicName = group ai-reviewer-bots
    deny forgeAuthor = group ai-reviewer-bots
    deny forgeCommitter = group ai-reviewer-bots

[access "refs/for/refs/heads/*"]
    # AI reviewer bots push new patchsets; humans push via gerrit push
    # or gh/GitHub review.
    push = group ai-reviewer-bots
    push = group non-ai-reviewer
    # O10: AI reviewer bots must not add patchsets to other humans'
    # open changes.  They may only push *new* changes (which land via
    # refs/for/*, above).  The addPatchSet override would otherwise
    # allow a compromised bot to tag-team a reviewer.
    deny addPatchSet = group ai-reviewer-bots

[access "refs/*"]
    # O10: the master-level lockdown — force-push, delete-ref,
    # create-ref and anything destructive is reserved for humans.
    deny push force = group ai-reviewer-bots
    deny pushMerge = group ai-reviewer-bots
    deny createTag = group ai-reviewer-bots
    deny create = group ai-reviewer-bots
    deny delete = group ai-reviewer-bots

[label "Code-Review"]
    function = NoBlock
    defaultValue = 0
    value = -2 Blocks submission (veto)
    value = -1 Disagree
    value =  0 No score
    value = +1 Looks good
    value = +2 Approved (scope-limited for AI, full for humans)
    copyCondition = is:MIN OR is:MAX
    # We intentionally do NOT set `function = MaxWithBlock` — the
    # submit-requirements below enforce the dual-+2 condition
    # explicitly (group-aware) rather than by label function alone.

[submit]
    mergeContent = true

# Submit-Requirements (OP-692 / OP-694 — replace the originally-planned
# Prolog rules.pl, which Gerrit 3.13 rejects).  Three blocks together
# implement the ADR 0003 dual-sign gate.

[submit-requirement "Human-Plus-2"]
    description = Requires +2 from non-ai-reviewer group (CLAUDE.md L1 human hard gate)
    submittableIf = label:Code-Review=+2,group=non-ai-reviewer
    canOverrideInChildProjects = false

[submit-requirement "Merger-Plus-2"]
    description = Requires +2 from merger-agent-bot (O6 conflict sign-off). Conditional: only applies when the change has the `Merge-Conflict-Resolved` hashtag, which the O6 Merger Agent sets after resolving a conflict block.
    applicableIf = hashtag:Merge-Conflict-Resolved
    submittableIf = label:Code-Review=+2,group=merger-agent-bot
    canOverrideInChildProjects = false

[submit-requirement "No-Veto"]
    description = No -1 or -2 votes blocking submission
    submittableIf = -label:Code-Review=-1 AND -label:Code-Review=-2
    canOverrideInChildProjects = false

# NOTE: The webhooks plugin reads its config from `webhooks.config` on
# the same `refs/meta/config` ref — NOT from this project.config file
# (per OP-713 lesson L22).  Prior versions of this example placed a
# `[plugin "webhooks"]` / `[remote "..."]` block here; they were silent
# no-ops and have been removed.  See ops runbook for the canonical
# webhooks.config layout.
