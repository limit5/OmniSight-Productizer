# O7 (#270) — OmniSight Gerrit project.config reference.
#
# This is the authoritative Gerrit submit-rule policy for OmniSight:
#
#   *** A change is only submittable when ALL of the following hold ***
#
#     (A) ≥1 Code-Review: +2 from a member of the `non-ai-reviewer` group
#         (i.e. a *human* reviewer).  This is the HARD GATE — no
#         amount of AI approval can substitute for it.  ONE narrow,
#         doubly-keyed carve-out: see (E).
#
#     (B) When the change carries the `Merge-Conflict-Resolved` hashtag
#         (set by the O6 Merger Agent after resolving a conflict block),
#         ≥1 Code-Review: +2 from a member of the `merger-agent-bot`
#         group is also required.  Non-conflict changes skip this rule
#         (see OP-694 — conditional Merger-Plus-2).
#
#     (C) No -1 / -2 votes anywhere (No-Veto rule).
#
#     (D) C1 OP-740 scaffolds a future Verified +1 CI gate.  The
#         Verified label and ci-bot ACL are installed now, but the
#         submit-requirement is default-OFF until C2 ships real CI.
#
#     (E) OP-962 / ADR-0016 path C — the develop→main auto-promote
#         fast-forward change (it carries the `milestone:R3-fastforward`
#         hashtag AND targets `refs/heads/main`) is exempt from (A) and
#         instead gated by `MainFastForwardMergerPlus2`: a Code-Review
#         +2 from `merger-agent-bot` OR `non-ai-reviewer`.  This lets
#         the merger-bot auto-submit the promotion change without an
#         operator click, while (C) No-Veto still applies (a -1 from the
#         merger-bot's own pre-vote validation — non-fast-forward,
#         author ≠ auto-promote-bot — or from an operator still blocks).
#         The carve-out is doubly-keyed (hashtag AND branch) on purpose;
#         a change matching only one key falls through to the full (A)
#         human gate.  ai-reviewer-bots cannot forge the hashtag (no
#         `editHashtags` on refs/for/*), so the carve-out can only be
#         tripped by the auto-promote push itself.
#
# Rule (A) is the CLAUDE.md L1 Safety Rule promotion.  Rule (B) is the
# O6 Merger contract — the merge conflict region must be AI-verified by
# the merger before humans are asked to sign off on it.  Rule (E) is the
# O6-style conditional-+2 pattern (OP-269) applied a second time, scoped
# strictly to the develop→main fast-forward.  All of these are encoded
# as declarative `[submit-requirement "..."]` blocks below.
#
# Group-based, NOT identity-based: adding a new AI reviewer (lint-bot /
# security-bot / any future bot) only requires adding the account to
# `ai-reviewer-bots` — no change to this rule.
#
# Install on `refs/meta/config` (per docs/ops/gerrit_dual_two_rule.md):
#
#   git fetch origin refs/meta/config:refs/remotes/origin/meta/config
#   git checkout meta/config
#   cp ../.gerrit/project.config.example project.config
#   git add project.config
#   git commit -m "OP-692: dual-+2 submit-requirements (human hard gate + conditional merger)"
#   git push origin HEAD:refs/meta/config
#
# Webhooks live in a separate `webhooks.config` file on the same ref —
# the webhooks plugin reads ONLY that file (per OP-713 lesson L22).
# See `.gerrit/webhooks.config.example` if/when added.
#
# Historical: an earlier attempt used a Prolog `rules.pl` for the
# submit-rule.  Gerrit 3.13 rejects new `rules.pl` uploads, so the policy
# moved entirely to declarative `[submit-requirement "..."]` blocks
# (OP-692 / OP-694 / OP-697).  The previous `.gerrit/rules.pl` was
# deleted as dead code.

[project]
    description = OmniSight productizer backend + frontend.
    state = active
    submitType = REBASE_IF_NECESSARY

[access "refs/heads/*"]
    # All AI reviewer bots (merger-agent-bot, lint-bot, security-bot, …)
    # can cast Code-Review votes but NEVER submit.
    #
    # OP-962 (ADR-0016 path C): this grant is branch-agnostic — it also
    # covers refs/heads/main, so merger-agent-bot may cast Code-Review
    # +2 on the develop→main auto-promote change.  That ACL is what
    # makes `MainFastForwardMergerPlus2` (below) effective; no separate
    # refs/for/main label grant is needed (a narrower main-only ACL
    # could only reduce coverage, never expand it).  ai-reviewer-bots
    # are NOT granted `editHashtags` on refs/for/* (see that section),
    # so a bot cannot forge the `milestone:R3-fastforward` hashtag onto
    # an arbitrary change to trip the carve-out — only the auto-promote
    # push (which uses a push option, like an operator push) sets it.
    label-Code-Review = -2..+2 group ai-reviewer-bots
    label-Code-Review = -2..+2 group non-ai-reviewer
    submit = group non-ai-reviewer
    # O10 (#273): Least-privilege for AI reviewer bots.  Explicitly
    # DENY every dangerous verb so even if Gerrit default policy
    # changes upstream, the bots stay trapped in Code-Review land.
    # DENY takes precedence over any later ALLOW on the same ref.
    deny submit = group ai-reviewer-bots
    deny abandon = group ai-reviewer-bots
    deny delete = group ai-reviewer-bots
    deny deleteChanges = group ai-reviewer-bots
    deny owner = group ai-reviewer-bots
    deny rebase = group ai-reviewer-bots
    deny editTopicName = group ai-reviewer-bots
    deny forgeAuthor = group ai-reviewer-bots
    deny forgeCommitter = group ai-reviewer-bots

[access "refs/heads/develop"]
    # OP-740 C1: ci-bot may report CI state via Verified only.
    # Do NOT add ci-bot to ai-reviewer-bots; it must not vote Code-Review.
    label-Verified = -1..+1 group ci-bot

[access "refs/heads/release/*"]
    # OP-740 C1: release branches use the same CI signal as develop.
    label-Verified = -1..+1 group ci-bot

[access "refs/for/refs/heads/*"]
    # AI reviewer bots push new patchsets; humans push via gerrit push
    # or gh/GitHub review.
    push = group ai-reviewer-bots
    push = group non-ai-reviewer
    # O10: AI reviewer bots must not add patchsets to other humans'
    # open changes.  They may only push *new* changes (which land via
    # refs/for/*, above).  The addPatchSet override would otherwise
    # allow a compromised bot to tag-team a reviewer.
    deny addPatchSet = group ai-reviewer-bots

[access "refs/*"]
    # O10: the master-level lockdown — force-push, delete-ref,
    # create-ref and anything destructive is reserved for humans.
    deny push force = group ai-reviewer-bots
    deny pushMerge = group ai-reviewer-bots
    deny createTag = group ai-reviewer-bots
    deny create = group ai-reviewer-bots
    deny delete = group ai-reviewer-bots

[label "Code-Review"]
    function = NoBlock
    defaultValue = 0
    value = -2 Blocks submission (veto)
    value = -1 Disagree
    value =  0 No score
    value = +1 Looks good
    value = +2 Approved (scope-limited for AI, full for humans)
    copyCondition = is:MIN OR is:MAX
    # We intentionally do NOT set `function = MaxWithBlock` — the
    # submit-requirements below enforce the dual-+2 condition
    # explicitly (group-aware) rather than by label function alone.

[label "Verified"]
    function = MaxWithBlock
    value = -1 Fails
    value =  0 No score
    value = +1 Verified
    copyCondition = changekind:NO_CODE_CHANGE OR changekind:TRIVIAL_REBASE
    # Sticky on trivial rebase so R3 auto-rebase does not force a CI
    # re-run when develop moved without overlapping diff.

[submit]
    mergeContent = true

# AUDIT-26 / ADR-0020 — release cut to `main` as a single merge change.
# refs/heads/main switches to MERGE_ALWAYS so the release-cut change
# (one merge commit pushed to refs/for/main by auto_promote_main —
# AUDIT-26d) submits as exactly one merge commit, never an N-change
# fast-forward chain (the OP-925 / AUDIT-13a bulk-chain failure mode).
# The project-global submitType above stays REBASE_IF_NECESSARY for
# every other branch.
#
# Deploy note (AUDIT-26e): if Gerrit 3.13 does not honour this per-ref
# [submit "refs/heads/main"] form, move it to project-global
# [project] submitType = MERGE_ALWAYS and re-confirm the develop /
# release/* impact per
# docs/audit/2026-05-12-audit-26-phase-0-verification.md §2.
[submit "refs/heads/main"]
    submitType = MERGE_ALWAYS

# Submit-Requirements (OP-692 / OP-694 / OP-962 / OP-982 — replace the
# originally-planned Prolog rules.pl, which Gerrit 3.13 rejects).
# Together these blocks implement the ADR 0003 dual-sign gate, the
# ADR-0016 path-C carve-out, and the ADR-0020 release-cut promotion.

[submit-requirement "Human-Plus-2"]
    description = Requires +2 from non-ai-reviewer group (CLAUDE.md L1 human hard gate). Conditional carve-out (OP-962 / ADR-0016 path C): NOT applicable to the develop->main auto-promote fast-forward change — that change carries the `milestone:R3-fastforward` hashtag AND targets branch:main, and is gated by MainFastForwardMergerPlus2 instead. EVERY other change on EVERY other branch — including any non-hashtagged change on main, or one carrying a different `milestone:*` hashtag — still requires the human +2. The carve-out is doubly-keyed on purpose (see error catalog `SubmitRuleOverScopes` in OP-962).
    applicableIf = -hashtag:"milestone:R3-fastforward" OR -branch:main
    submittableIf = label:Code-Review=+2,group=non-ai-reviewer
    canOverrideInChildProjects = false

[submit-requirement "Merger-Plus-2"]
    description = Requires +2 from merger-agent-bot (O6 conflict sign-off). Conditional: only applies when the change has the `Merge-Conflict-Resolved` hashtag, which the O6 Merger Agent sets after resolving a conflict block.
    applicableIf = hashtag:Merge-Conflict-Resolved
    submittableIf = label:Code-Review=+2,group=merger-agent-bot
    canOverrideInChildProjects = false

[submit-requirement "MainFastForwardMergerPlus2"]
    # OP-962 / ADR-0016 path C — conditional merger-bot +2 for the
    # develop->main auto-promote fast-forward change.
    #
    # Applicability is doubly-keyed: the change MUST carry the
    # `milestone:R3-fastforward` hashtag (emitted by
    # backend/agents/auto_promote_main.py — never settable by an
    # ai-reviewer-bot, which lacks editHashtags on refs/for/*) AND
    # target refs/heads/main. A change matching only one key (e.g. an
    # arbitrary change pushed to refs/for/main with no hashtag, or a
    # `milestone:something-else` change) does NOT match here and falls
    # through to the unconditional Human-Plus-2 gate above — that is the
    # mandatory `SubmitRuleOverScopes` regression invariant.
    #
    # When applicable, this requirement is satisfied by a Code-Review
    # +2 from EITHER merger-agent-bot (path C — zero operator click) OR
    # a non-ai-reviewer (path A — operator manual submit stays
    # available as the fallback documented in ADR-0016). The No-Veto
    # requirement below still applies, so any -1/-2 still blocks
    # submission — including the -1 the merger-bot casts when its
    # pre-vote validation fails (non-fast-forward, or author is not the
    # auto-promote bot). Fast-forward-ness and author identity are
    # enforced upstream (auto_promote_main refuses to even create a
    # non-FF change; the merger-bot poller re-validates author + FF
    # before voting); the submit-requirement deliberately does not
    # duplicate them because Gerrit's query language cannot express
    # "this change is a fast-forward of main".
    description = auto-promote-bot or merger-bot +2 allowed only for milestone:R3-fastforward auto-promote changes on main
    applicableIf = hashtag:"milestone:R3-fastforward" AND branch:main
    submittableIf = (label:Code-Review=+2,group=merger-agent-bot) OR (label:Code-Review=+2,group=non-ai-reviewer)
    canOverrideInChildProjects = false

[submit-requirement "release-cut-promote"]
    # OP-982 / AUDIT-26c / ADR-0020 — the release cut is ONE merge change
    # on refs/heads/main (submitType=MERGE_ALWAYS, above; pushed to
    # refs/for/main by auto_promote_main per AUDIT-26d), not an N-change
    # fast-forward chain. This requirement generalises
    # MainFastForwardMergerPlus2 from a doubly-keyed to a QUADRUPLY-keyed
    # carve-out, and — unlike that rule — it is CO-EXIST, not substitute:
    # it requires a merger-agent-bot +2 IN ADDITION TO the standing
    # non-ai-reviewer (human) +2, so the CLAUDE.md L1 "human +2 required
    # for merge" rule is untouched. The merger-bot +2 is the mechanical
    # attestation ("this merge commit really is a clean promotion of
    # accepted develop content"); the human +2 is the release
    # authorisation. Both are needed.
    #
    # Applicability is QUADRUPLY keyed — a change must (1) target
    # branch:main, (2) carry a topic matching ^release-v[0-9]+[.][0-9]+[.][0-9]+.*$
    # (i.e. release-vX.Y.Z, tolerating -rcN / +build suffixes — written
    # with [0-9]/[.] rather than \d/\. to avoid git-config backslash-
    # escaping ambiguity; semantically identical), (3) carry the
    # milestone:R3-fastforward hashtag (auto_promote_main emits it; an
    # ai-reviewer-bot cannot forge it — no editHashtags on refs/for/* —
    # see [access "refs/for/refs/heads/*"]), and (4) be authored by one
    # of the release-cut identities (auto-promote-bot / claude-bot /
    # codex-bot). A change missing ANY key falls through to the
    # unconditional Human-Plus-2 gate — the SubmitRuleOverScopes
    # regression invariant (tightened from OP-962's two keys to four).
    #
    # No-Veto (below) still applies, so a -1 (incl. the one the
    # merger-bot casts when its pre-vote validation fails) hard-blocks.
    #
    # Transition: MainFastForwardMergerPlus2 above and the Human-Plus-2
    # carve-out become redundant once auto_promote_main is rewritten
    # (AUDIT-26d) to push the topic'd merge change; AUDIT-26f removes /
    # re-keys them. They co-exist consistently in the interim (the
    # stricter AND gate here wins for genuine release cuts). See ADR-0020.
    description = Release-cut promotion to main; conditional merger-bot +2 acceptable when topic + hashtag + author match the auto-promote pattern.
    applicableIf = branch:main AND topic:^release-v[0-9]+[.][0-9]+[.][0-9]+.*$ AND hashtag:"milestone:R3-fastforward" AND author:^auto-promote-bot$|^claude-bot$|^codex-bot$
    submittableIf = (label:Code-Review=+2,group=merger-agent-bot) AND (label:Code-Review=+2,group=non-ai-reviewer)
    canOverrideInChildProjects = false

[submit-requirement "No-Veto"]
    description = No -1 or -2 votes blocking submission
    submittableIf = -label:Code-Review=-1 AND -label:Code-Review=-2
    canOverrideInChildProjects = false

[submit-requirement "Verified"]
    description = CI tests must pass (asserted by ci-bot via Verified+1). OP-740 C1 default-OFF until C2 flips enforcement on with real CI.
    applicableIf = is:false
    submittableIf = label:Verified=+1
    canOverrideInChildProjects = false

# NOTE: The webhooks plugin reads its config from `webhooks.config` on
# the same `refs/meta/config` ref — NOT from this project.config file
# (per OP-713 lesson L22).  Prior versions of this example placed a
# `[plugin "webhooks"]` / `[remote "..."]` block here; they were silent
# no-ops and have been removed.  See ops runbook for the canonical
# webhooks.config layout.
