{
  "name": "launcher-web",
  "version": "0.1.0",
  "private": true,
  "description": "OmniSight launcher (web renderer). Built as both a static SPA served by the headless IPCAM AND a consumable React component library (U4.1) — see `exports` map + lib/index.ts. Brand sourced from design-system/design-tokens.json via gen_web_theme.py.",
  "main": "./lib/index.ts",
  "module": "./lib/index.ts",
  "types": "./lib/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.ts",
      "import": "./lib/index.ts",
      "default": "./lib/index.ts"
    },
    "./components/AppGrid": {
      "types": "./components/AppGrid.tsx",
      "import": "./components/AppGrid.tsx",
      "default": "./components/AppGrid.tsx"
    },
    "./components/AppTile": {
      "types": "./components/AppTile.tsx",
      "import": "./components/AppTile.tsx",
      "default": "./components/AppTile.tsx"
    },
    "./components/CategoryStrip": {
      "types": "./components/CategoryStrip.tsx",
      "import": "./components/CategoryStrip.tsx",
      "default": "./components/CategoryStrip.tsx"
    },
    "./lib/manifest": {
      "types": "./lib/manifest.ts",
      "import": "./lib/manifest.ts",
      "default": "./lib/manifest.ts"
    },
    "./lib/launch": {
      "types": "./lib/launch.ts",
      "import": "./lib/launch.ts",
      "default": "./lib/launch.ts"
    },
    "./lib/icons": {
      "types": "./lib/icons.ts",
      "import": "./lib/icons.ts",
      "default": "./lib/icons.ts"
    },
    "./lib/types": {
      "types": "./lib/types.ts",
      "import": "./lib/types.ts",
      "default": "./lib/types.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "components",
    "README.md"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:theme": "python3 scripts/gen_web_theme.py --tokens ../design-system/design-tokens.json --out app/globals.css",
    "check:theme": "python3 scripts/gen_web_theme.py --tokens ../design-system/design-tokens.json --out app/globals.css --check"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "lucide-react": "^1.21.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "js-yaml": "^5.0.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
