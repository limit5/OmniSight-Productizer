# [OP-971] AUDIT-19a — staging compose env template.
#
# Copy this to the staging host as `deploy/staging/.env` (and, for
# host-specific overrides, `deploy/staging/.env.local`), then fill in the
# real values. `infra/staging/verify-env-contract.sh` runs as the
# ExecStartPre of omnisight-staging-compose.service and will refuse to
# start the stack if any value below still looks like a PRODUCTION value
# (prod Postgres DSN, sk_live_ Stripe key, prod Anthropic key, a Slack
# webhook that isn't a staging webhook, or a missing environment=staging).
#
#   cp infra/staging/.env.template deploy/staging/.env
#   ${EDITOR:-nano} deploy/staging/.env
#   chmod 600 deploy/staging/.env          # contains secrets
#
# Never commit deploy/staging/.env — it is .gitignored. This template is
# the only env artifact that lives in git.

# ── Environment marker (REQUIRED — contract check #3) ────────────────
# Both are accepted; export at least `environment=staging`.
environment=staging
OMNISIGHT_ENV=staging

# ── Postgres (REQUIRED — contract check #1) ──────────────────────────
# The DSN's database name MUST end with -staging / _staging, OR connect on
# a staging port (55432 / 55433). Pointing this at the prod DB name on the
# prod port is the exact mistake the contract check exists to catch.
POSTGRES_USER=omnisight
POSTGRES_PASSWORD=CHANGE_ME_staging_only
POSTGRES_DB=omnisight_staging
STAGING_POSTGRES_PORT=55432
# Optional: an explicit SQLAlchemy URL. If unset the compose file builds
# one from POSTGRES_* above. If you set it, keep the -staging db name.
# OMNISIGHT_DATABASE_URL=postgresql+asyncpg://omnisight:CHANGE_ME@postgres:5432/omnisight_staging

# ── Images ───────────────────────────────────────────────────────────
OMNISIGHT_GHCR_NAMESPACE=your-org
OMNISIGHT_IMAGE_TAG=latest

# ── External API keys (contract check #2 — sandbox prefixes only) ────
# Stripe: MUST start with sk_test_  (sk_live_ => instant hard fail)
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Anthropic: leave empty, or use a key whose name contains test/sandbox/eval.
# A production Anthropic key here is a hard fail.
ANTHROPIC_API_KEY=
OMNISIGHT_ANTHROPIC_API_KEY=
# Slack: leave empty, or use a webhook URL that contains "staging".
SLACK_WEBHOOK_URL=
OMNISIGHT_STAGING_ALERT_WEBHOOK=

# ── Ingress / health ─────────────────────────────────────────────────
STAGING_HOSTNAME=staging.sora.services
STAGING_HTTP_PORT=8080
STAGING_HTTPS_PORT=8443
STAGING_BACKEND_A_PORT=8010
STAGING_BACKEND_B_PORT=8011
STAGING_FRONTEND_PORT=3010
# Healthz endpoint the systemd unit's ExecStartPost curls after `up -d
# --wait`. Must match the port the staging Caddy/backends expose /healthz
# on. If you change this, also set OMNISIGHT_STAGING_HEALTHZ_URL in
# ~/.config/omnisight/staging-compose.env so the unit agrees.
OMNISIGHT_STAGING_HEALTHZ_PORT=9000

# ── Optional: bridge daemon (profile-gated; usually left off) ────────
# STAGING_GERRIT_ENABLED=false

# ── Optional: cgroup policy ──────────────────────────────────────────
# Set to 1 to make the CgroupV1Fallback warning a hard refusal (boxes
# that can only do cgroup v1 can't honour the unit's percentage limits).
# OMNISIGHT_STAGING_REQUIRE_CGROUP_V2=0
