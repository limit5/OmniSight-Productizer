#!/usr/bin/env python3
# description: Run pytest for one path and return pass/fail/error counts.
from __future__ import annotations

import json
import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path


def _read_input() -> dict:
    raw = sys.stdin.read().strip()
    return json.loads(raw) if raw else {}


def _pytest_cmd() -> list[str]:
    override = os.environ.get("OMNISIGHT_RUN_TESTS_PYTEST", "").strip()
    if override:
        return shlex.split(override)
    venv_pytest = Path("backend/.venv/bin/pytest")
    if venv_pytest.exists():
        return [str(venv_pytest)]
    return [sys.executable, "-m", "pytest"]


def _summary_counts(output: str) -> tuple[int, int, list[str]]:
    passed = failed = 0
    errors: list[str] = []
    for count, label in re.findall(
        r"(\d+)\s+(passed|failed|error|errors)\b", output
    ):
        value = int(count)
        if label == "passed":
            passed += value
        elif label == "failed":
            failed += value
        else:
            errors.append(f"{value} {label}")
    if not errors:
        for line in output.splitlines():
            if line.startswith("ERROR ") or " ERROR " in line:
                errors.append(line[:240])
    return passed, failed, errors


def main() -> int:
    payload = _read_input()
    test_path = str(payload.get("test_path") or payload.get("args") or "").strip()
    if not test_path:
        raise SystemExit("test_path is required")

    started = time.perf_counter()
    proc = subprocess.run(
        [*_pytest_cmd(), test_path],
        text=True,
        capture_output=True,
        check=False,
    )
    duration_s = time.perf_counter() - started
    passed, failed, errors = _summary_counts(proc.stdout + "\n" + proc.stderr)
    print(
        json.dumps(
            {
                "passed": passed,
                "failed": failed,
                "errors": errors,
                "duration_s": round(duration_s, 3),
            }
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
