# Generated by SKILL-DESKTOP-TAURI (X8 #304) — local dev environment.
# Copy to `.env` and fill in real values. Vite exposes only keys prefixed
# `VITE_` to the webview; everything else stays build-time or server-side
# (Rust) and must never reach the frontend bundle.

# Frontend (exposed to the webview — never put secrets here)
VITE_APP_NAME=

# Updater signing (tauri-plugin-updater, when updater=on) — minisign key
# `tauri build` uses to sign `latest.json`. Keep the private key OUT of
# git; CI injects it as a secret (see .github/workflows/release.yml).
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
