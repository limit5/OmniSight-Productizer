# Generated by SKILL-GO-SERVICE (X6 #302) — local dev environment.
# Copy to `.env` and fill in real values before running. Every setting
# funnels through internal/config (envconfig); the names below match the
# `envconfig:"..."` tags one-for-one.

# Runtime
APP_ENV=dev
LOG_LEVEL=info
ADDR=:8080

# CORS — comma-separated origins; `*` allows any (dev only).
CORS_ORIGINS=*

# Database connection string (read as DATABASE_URL). Pick the line that
# matches your `database` knob; the scaffold ships an in-memory store, so
# an empty value still boots.
#   PostgreSQL:  postgresql://USER:PASS@localhost:5432/DBNAME?sslmode=disable
#   SQLite:      file:./app.db?_pragma=journal_mode(WAL)   (file-backed, WAL)
DATABASE_URL=
