# Generated by SKILL-SPRING-BOOT (X9 #305) — local dev environment.
# Copy to `.env` and export before running. Names mirror the `${...}`
# placeholders in src/main/resources/application.yaml one-for-one.

# Spring profile + server
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# App
APP_ENVIRONMENT=dev
APP_LOG_LEVEL=info

# Datasource — set these when the `database` knob is not `none`. Pick the
# URL for your DB:
#   PostgreSQL: jdbc:postgresql://localhost:5432/DBNAME
#   H2 (mem):   jdbc:h2:mem:DBNAME;DB_CLOSE_DELAY=-1
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
