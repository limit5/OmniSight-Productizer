            return False

    except subprocess.TimeoutExpired:
        elapsed = time.time() - start_time
        print(f"\n⏰ [超時] 項目執行超過 {TASK_TIMEOUT_S}s，強制終止。")
        print(f"⏱️ [耗時] {_fmt_duration(elapsed)}")
        if process is not None:
            try:
