  - auto-runner-jira.py
  - backend/agents/gerrit_jira_bridge.py
  - docs/sop/runner-state-authority-precedence.md
  - tests/test_state_authority_resolver.py
forbidden_paths: []
class: subscription-claude
authority_required: L3
tag_type: story
schema_version: v0
mutex_with: [SP-B-X-002a, SP-B-X-003, SP-B-X-004, SP-B-X-009, SP-B-X-011]
dependency_artifacts:
  - "release_audit table (per ADR-0021)"
  - "SP-B-X-001 idempotency primitives"
  - "backend/agents/live_state_check.py (SP-B-X-004 TOCTOU primitive)"
