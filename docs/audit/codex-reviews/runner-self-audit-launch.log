  - tests/test_runner_orphan_reaper.py
  - docs/sop/runbooks/orphan-reaper.md
forbidden_paths:
  - backend/agents/jira_dispatch.py              # IMPORT only
  - backend/agents/operator_notifier.py          # IMPORT only
  - auto-runner-jira.py
class: subscription-claude
authority_required: L3
tag_type: story
schema_version: v0
runtime_capability: integration
evidence_class: integration
mutex_with: []
on_scope_creep: file-followup
