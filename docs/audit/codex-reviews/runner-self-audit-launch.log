MAX_RETRIES = int(os.environ.get("OMNISIGHT_CODEX_MAX_RETRIES", "2"))
COOLDOWN_S = int(os.environ.get("OMNISIGHT_CODEX_COOLDOWN", "5"))
SECTION_COOLDOWN_S = int(os.environ.get("OMNISIGHT_CODEX_SECTION_COOLDOWN", "10"))

